    <div class="TableOfContents" id="TOC">
        <div class="WidgetSimple">
            <div class="oooFAQTOC">
                <ul class="oooFAQSidebarList">
                    <li class="oooFAQHeader">[% Translate("Table of Contents") | html %]</li>

[% RenderBlockStart("ArticleField") %]
                    <li class="oooFAQTOCArticle">
                        <i class="fa fa-angle-right TOCLevel1"></i>
                        <a href="#[% Data.Field %]" title="[% Translate(Data.Caption) | html %]" class="LinkLevel">[% Translate(Data.Caption) | html %]</a>
                    </li>
[% RenderBlockStart("ArticleAnchor") %]
                    <li class="oooFAQTOCArticle" style="position: relative; left: [% Data.Padding | html %]px;">
                        <i class="fa fa-angle-right TOCLevel2"></i>
                        <a href="javascript:void(0)" onclick="FAQ.Improvements.FAQ.anchorFrameScroll('IframeFAQ[% Data.Field %]','[% Data.ID %]');"
                           title="[% Translate(Data.Caption) | html %]" class="LinkLevel2">[% Translate(Data.Caption) | html %]</a>
                    </li>
[% RenderBlockEnd("ArticleAnchor") %]

[% RenderBlockEnd("ArticleField") %]

            </ul>
           </div>
        </div>
    </div>
