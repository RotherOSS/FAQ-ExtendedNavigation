    <div class="SidebarArea" id="FAQSidebar">

[% RenderBlockStart("SideBar") %]
        <div class="WidgetSimple MainSideBar">

[% RenderBlockStart("HeaderTitle") %]
                <div class="Header">
                    <h2>[% Translate("Quickstart Links") | html %]</h2>
                </div>
[% RenderBlockEnd("HeaderTitle") %]

                <div class="oooFAQSidebar">
                    <ul class="oooFAQSidebarList">
[% RenderBlockStart("Header") %]
                    <li class="[% Data.Class | html %]" data-name="[% Data.Subcategory | html %]">[% Data.Arrow %][% Data.Header | html %]</li>

[% RenderBlockStart("ArticleLink") %]
                    <li class="oooFAQSidebarArticle [% Data.Class | html %]">
                        [% Data.Icon %]
                        <a href="[% Env('BaseLink') %]?Action=[% Data.Action | uri %];ItemID=[% Data.ID %]" title="[% Data.Title | html %]">[% Data.Title | html %]</a>
                    </li>
[% RenderBlockEnd("ArticleLink") %]

[% RenderBlockEnd("Header") %]
                    </ul>
                </div>
        </div>
[% RenderBlockEnd("SideBar") %]

[% RenderBlockStart("FAQExplorerLink") %]
        <div class="WidgetSimple">
            <div class="oooFAQExplorer">
                <ul class="oooFAQLinks">
[% RenderBlockStart("FAQBackHomeLink") %]
                <li>
                    <a href="[% Env('BaseLink') %]?Action=[% Data.HomeAction | uri %]" title="[% Translate("Back to FAQ Home") | html %]" class="LinkFAQExplorer"><i class="fa fa-home oooSideBarIconHome"></i> [% Translate("Back to FAQ Home") | html %]</a>
                </li>
[% RenderBlockEnd("FAQBackHomeLink") %]
                <li>
                    <a href="[% Env('BaseLink') %]?Action=[% Data.ExplorerAction | uri %]" title="[% Translate("FAQ Explorer") | html %]" class="LinkFAQExplorer [% IF Data.IsDefaultArticle %]oooFAQLinkPosition[% END %]"><img class="oooSideBarIconExplorer">  [% Translate("FAQ Explorer") | html %]</a>
                </li>
                </ul>
            </div>
        </div>
[% RenderBlockEnd("FAQExplorerLink") %]

[% RenderBlockStart("FAQBackHomeBlock") %]
        <div class="WidgetSimple">
            <div class="oooFAQExplorer">
                <ul class="oooFAQLinks">
                    <li>
                        <a href="[% Env('BaseLink') %]?Action=[% Data.HomeAction | uri %]" title="[% Translate("Back to FAQ Home") | html %]" class="LinkFAQExplorer"><i class="fa fa-home oooSideBarIconHome oooFAQLinkFirst"></i> [% Translate("Back to FAQ Home") | html %]</a>
                    </li>
                </ul>
            </div>
        </div>
[% RenderBlockEnd("FAQBackHomeBlock") %]
    </div>
