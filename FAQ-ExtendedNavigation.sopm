        <File Permission="660" Location="Custom/Kernel/Modules/PublicFAQExplorer.pm" />
        <File Permission="660" Location="Custom/Kernel/Modules/PublicFAQZoom.pm" />
        <File Permission="660" Location="Custom/Kernel/Modules/AgentFAQExplorer.pm" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Layout.pm" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Layout/FAQ.pm" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/AgentFAQAdd.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/AgentFAQEdit.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/AgentFAQZoom.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/CustomerFAQExplorer.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/CustomerFAQZoom.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/PublicFAQExplorer.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/PublicFAQZoom.tt" />
        <File Permission="660" Location="Custom/Kernel/Output/HTML/Templates/Standard/AgentFAQExplorer.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/AgentFAQSidebar.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Layout/FAQExtendedNavigation.pm" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/FAQ/FAQAdditionalData.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/FAQ/FAQSideBar.tt" />
        <File Permission="660" Location="Kernel/Output/HTML/Templates/Standard/FAQ/FAQTableOfContents.tt" />
        <File Permission="660" Location="var/httpd/htdocs/js/FAQ.ExtendedNavigation.FAQ.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/Core.UI.CKEditor5Wrapper.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/Core.UI.RichTextEditor.js" />
        <File Permission="660" Location="var/httpd/htdocs/js/FAQ.Agent.Sidebar.js" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/FAQExtendedNavigation.Agent.Default.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/FAQExtendedNavigation.Agent.Detail.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/FAQ.Agent.Sidebar.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/css/RichTextArticleContent.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/css/FAQExtendedNavigation.Customer.Default.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/css/FAQExtendedNavigation.Customer.Detail.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/css/RichTextArticleContent.css" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Customer/default/img/home.svg" />
        <File Permission="660" Location="var/httpd/htdocs/skins/Agent/default/img/faq.svg" />
    </Filelist>
    <DatabaseInstall Type="post">
        <TableAlter Name="faq_item">
            <ColumnAdd Name="icon" Type="LONGBLOB" Required="false" />
        </TableAlter>
    </DatabaseInstall>
    <DatabaseUninstall>
        <TableAlter Name="faq_item">
            <ColumnDrop Name="icon" />
        </TableAlter>
    </DatabaseUninstall>
    <IntroInstall Lang="en" Title="Install Information" Type="pre">
        &lt;br&gt;
        WELCOME!&lt;br&gt;
        &lt;br&gt;
        You are about to install the package to improve navigation in the FAQ module.&lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        Please click continue to proceed!&lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="de" Title="Installationsinformationen" Type="pre">
        &lt;br&gt;
        Herzlich willkommen!&lt;br&gt;
        &lt;br&gt;
        Sie sind im Begriff, das Paket zur Verbesserung der Navigation im FAQ-Modul zu installieren.&lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        Bitte klicken Sie auf „Weiter“, um fortzufahren!&lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="es" Title="Información de Instalación" Type="pre">
        &lt;br&gt;
        BIENVENIDO!&lt;br&gt;
        &lt;br&gt;
        Está a punto de instalar el paquete para mejorar la navegación en del módulo de las FAQ.&lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        Haga clic en continuar para proceder!&lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
    <IntroInstall Lang="hu" Title="Telepítési információk" Type="pre">
        &lt;br&gt;
        Üdvözöljük!&lt;br&gt;
        &lt;br&gt;
        A GYIK modul navigációjának javítását célzó csomag telepítésére készülsz.&lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        &lt;br&gt;
        A folytatáshoz kérjük kattintson a folytatás gombra!&lt;br&gt;
        &lt;br&gt;
    </IntroInstall>
</otobo_package>
